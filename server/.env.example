# Neon PostgreSQL connection string (server-only secret)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Copy both values from the Neon Auth settings. They are public endpoints, not secrets.
NEON_AUTH_BASE_URL=https://YOUR_AUTH_HOST/neondb/auth
NEON_AUTH_JWKS_URL=https://YOUR_AUTH_HOST/neondb/auth/.well-known/jwks.json

# Optional provider key. If omitted, users must enter their own Groq API key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Cloud Run supplies PORT. HOST must be 0.0.0.0 in containers.
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
CORS_ORIGINS=chrome-extension://your-published-extension-id
MAX_CONTEXT_CHARS=10000
MAX_HISTORY_TURNS=10
DB_POOL_MAX=5
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_READ_PER_MINUTE=120
RATE_LIMIT_WRITE_PER_MINUTE=30
