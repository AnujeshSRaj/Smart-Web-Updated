{
  "manifest_version": 3,
  "name": "Smart Web Assistant",
  "version": "1.0.3",
  "description": "Secure backend-authenticated web assistant. Uses the canonical extension UI.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://smart-web-updated12-266348641987.us-east5.run.app/*"
  ],
  "externally_connectable": {
    "matches": ["https://smart-web-updated12-266348641987.us-east5.run.app/*"]
  },
  "background": { "service_worker": "extension/background.js" },
  "action": {
    "default_popup": "extension/popup.html",
    "default_title": "Smart Web Assistant"
  }
}
